# Copy to .env (never commit .env). Used by docker compose.
# Codex auth is the Windows file %USERPROFILE%\.codex\auth.json, bind-mounted.

LLM_BACKEND=codex
LLM_MODEL=dolphin-llama3:8b
LLM_API_KEY=ollama
TTS_DEVICE=cuda
ZEROTTS_DEVICE=cuda

# Host Ollama (Windows app already running on 127.0.0.1:11434):
LLM_BASE_URL=http://host.docker.internal:11434/v1

# New machine without Ollama — uncomment both:
# LLM_BASE_URL=http://ollama:11434/v1
# COMPOSE_PROFILES=bundled-ollama

# Optional: override Codex dir (defaults to %USERPROFILE%\.codex)
# CODEX_DIR=C:\Users\Administrator\.codex

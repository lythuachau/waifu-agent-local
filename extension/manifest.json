{
  "manifest_version": 3,
  "name": "Waifu Agent (local)",
  "description": "__MSG_extDescription__",
  "version": "1.0.4.43",
  "icons": {
    "16": "assets/waifu-agent-16.png",
    "32": "assets/waifu-agent-32.png",
    "48": "assets/waifu-agent-48.png",
    "128": "assets/waifu-agent-128.png"
  },
  "default_locale": "en",
  "homepage_url": "http://127.0.0.1:8787",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_extActionTitle__",
    "default_icon": {
      "16": "assets/waifu-agent-16.png",
      "32": "assets/waifu-agent-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "renderer.js",
        "avatar-frame.html",
        "chunks/*",
        "assets/*",
        "avatars/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "page-text-hook.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end",
      "js": [
        "content-scripts/content.js"
      ]
    }
  ]
}